{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Site Reliability Engineering (SRE) - SLI, SLO & Error Budget Tracker",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99.5 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "Availability SLI (Target: 99.9% SLO)",
      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "(sum(rate(payment_http_requests_total{status_code!~\"5..\"}[5m])) / sum(rate(payment_http_requests_total[5m]))) * 100",
          "legendFormat": "Current Availability %"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 80 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "Error Budget Remaining (1 - Unreliability / Budget)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "100 - (((1 - (sum(rate(payment_http_requests_total{status_code!~\"5..\"}[5m])) / sum(rate(payment_http_requests_total[5m])))) / 0.001) * 100)",
          "legendFormat": "Error Budget %"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "Circuit Breaker & Active Chaos States",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "payment_circuit_breaker_state",
          "legendFormat": "Circuit Breaker (0=Closed, 2=Open)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "payment_chaos_mode_active",
          "legendFormat": "Chaos Injection Active"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "id": 5,
      "title": "Error Budget Burn Rate Over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "((sum(rate(payment_http_requests_total{status_code=~\"5..\"}[1m])) / sum(rate(payment_http_requests_total[1m]))) / 0.001)",
          "legendFormat": "Burn Rate Multiplier (1x = standard, >14x = fast burn)"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["sre", "slo", "sli", "error-budget"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "SRE Reliability, SLI/SLO & Error Budget Observatory",
  "uid": "sre-sli-slo-error-budget"
